{
  // Production Worker, deployed from `main` with `npx wrangler deploy`.
  "name": "kengym",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    // Beta Worker, deployed from `develop` with `--env beta`.
    // Inherits the settings above; vars and bindings are not inherited.
    "beta": {
      "name": "kengym-beta"
    }
  }
}
